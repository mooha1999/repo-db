from __future__ import annotations

from dataclasses import fields
from enum import Enum
from typing import Any, cast

from sqlalchemy import inspect as sa_inspect
from sqlalchemy.orm import (
    RelationshipProperty,
    joinedload,
    selectinload,
    subqueryload,
)


class LoadStrategy(str, Enum):
    SELECT_IN = "selectin"
    JOINED = "joined"
    SUBQUERY = "subquery"


def _get_loader(strategy: LoadStrategy) -> Any:
    """Get the SQLAlchemy loader function for a strategy."""
    if strategy == LoadStrategy.SELECT_IN:
        return selectinload
    elif strategy == LoadStrategy.JOINED:
        return joinedload
    elif strategy == LoadStrategy.SUBQUERY:
        return subqueryload
    raise ValueError(f"Unknown load strategy: {strategy}")


def apply_load_options(query: Any, load_options: Any, model_class: type[Any]) -> Any:
    """
    Apply load options from a dataclass to a SQLAlchemy query.

    For each non-None field in load_options:
    - If it's a LoadStrategy enum, apply the corresponding loader.
    - If it's a nested LoadOptions dataclass, apply the default strategy
      and recurse into the nested options.

    Default strategies:
    - to-one (uselist=False): joinedload
    - to-many (uselist=True): selectinload
    """
    mapper: Any = cast(Any, sa_inspect(model_class))
    relationships: dict[str, RelationshipProperty[Any]] = {
        r.key: r for r in mapper.relationships  # type: ignore[union-attr]
    }

    for field in fields(load_options):
        value: Any = getattr(load_options, field.name)
        if value is None:
            continue

        rel: RelationshipProperty[Any] | None = relationships.get(field.name)
        if rel is None:
            continue

        rel_attr: Any = getattr(model_class, field.name)

        if isinstance(value, LoadStrategy):
            loader = _get_loader(value)
            query = query.options(loader(rel_attr))
        elif hasattr(value, "__dataclass_fields__"):
            # Nested load options - use default strategy based on relationship type
            if rel.uselist:
                default_strategy = LoadStrategy.SELECT_IN
            else:
                default_strategy = LoadStrategy.JOINED
            loader = _get_loader(default_strategy)
            # Apply the loader and recurse
            loader_opt: Any = loader(rel_attr)
            related_class: type[Any] = rel.mapper.class_  # type: ignore[union-attr]
            query = query.options(
                _apply_nested_load_options(loader_opt, value, related_class)
            )

    return query


def _apply_nested_load_options(
    parent_loader: Any, load_options: Any, model_class: type[Any]
) -> Any:
    """Recursively apply nested load options."""
    mapper: Any = cast(Any, sa_inspect(model_class))
    relationships: dict[str, RelationshipProperty[Any]] = {
        r.key: r for r in mapper.relationships  # type: ignore[union-attr]
    }

    current: Any = parent_loader
    for field in fields(load_options):
        value: Any = getattr(load_options, field.name)
        if value is None:
            continue

        rel: RelationshipProperty[Any] | None = relationships.get(field.name)
        if rel is None:
            continue

        rel_attr: Any = getattr(model_class, field.name)

        if isinstance(value, LoadStrategy):
            loader = _get_loader(value)
            current = current.options(loader(rel_attr))
        elif hasattr(value, "__dataclass_fields__"):
            if rel.uselist:
                default_strategy = LoadStrategy.SELECT_IN
            else:
                default_strategy = LoadStrategy.JOINED
            loader = _get_loader(default_strategy)
            related_class: type[Any] = rel.mapper.class_  # type: ignore[union-attr]
            nested: Any = _apply_nested_load_options(
                loader(rel_attr), value, related_class
            )
            current = current.options(nested)

    return current
