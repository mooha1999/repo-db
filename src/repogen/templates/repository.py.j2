        if load_options is not None:
            query = apply_load_options(query, load_options, {{ model.class_name }})
        if order_by is not None:
            for field in order_by:
                if field.startswith("-"):
                    col: Any = getattr({{ model.class_name }}, field[1:], None)
                    if col is not None:
                        query = query.order_by(col.desc())
                else:
                    col = getattr({{ model.class_name }}, field, None)
