    async def create(self, dto: {{ model.class_name }}Create) -> {{ model.class_name }}:
        """Create a single {{ model.class_name }} from a validated DTO."""
        instance = {{ model.class_name }}(**dto.model_dump(exclude_unset=True))
        self._session.add(instance)
        await self._session.flush()
        await self._session.refresh(instance)
        return instance

    async def create_many(self, dtos: list[{{ model.class_name }}Create]) -> list[{{ model.class_name }}]:
        """Bulk create {{ model.class_name }} records."""
        instances = [{{ model.class_name }}(**dto.model_dump(exclude_unset=True)) for dto in dtos]
        self._session.add_all(instances)
        await self._session.flush()
        for instance in instances:
            await self._session.refresh(instance)
        return instances

    async def update(self, dto: {{ model.class_name }}Update) -> {{ model.class_name }} | None:
        """
        Update a {{ model.class_name }}. Only non-None fields in the DTO are applied.
        Returns the updated {{ model.class_name }} or None if not found.
        """
        instance = await self.get_by_id({{ pk_dto_access }})
