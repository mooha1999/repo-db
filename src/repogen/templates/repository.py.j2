        update_data = dto.model_dump(exclude_unset=True)
        for key in {{ pk_names }}:
            update_data.pop(key, None)
        for key, value in update_data.items():
            setattr(instance, key, value)
        await self._session.flush()
        await self._session.refresh(instance)
        return instance

